---
import ResourceCard from "./ResourceCard.astro";
import { useTranslations, t } from "../i18n";

export interface Props {
  page: {
    data: any[];
    currentPage: number;
    lastPage: number;
    url: {
      prev: string | undefined;
      next: string | undefined;
    };
  };
}

const { page } = Astro.props;
const locale: Locale = (Astro.cookies.get("lang")?.value as Locale) || "en";
const i18n = useTranslations(locale);
---

<div class="resources-grid-wrapper">
  {
    page.data.length === 0 ? (
      <div class="resources-empty">{i18n.resources.noResources}</div>
    ) : (
      <div class="resources-grid">
        {page.data.map((resource) => (
          <ResourceCard resource={resource} />
        ))}
      </div>
    )
  }
</div>

{
  page.lastPage > 1 && (
    <div class="resources-pagination">
      {page.url.prev ? (
        <a href={page.url.prev} class="pagination-btn">
          {i18n.resources.previous}
        </a>
      ) : (
        <button disabled class="pagination-btn">
          {i18n.resources.previous}
        </button>
      )}

      <span class="pagination-info">
        {t(i18n.resources.pageOf, { current: page.currentPage, total: page.lastPage })}
      </span>

      {page.url.next ? (
        <a href={page.url.next} class="pagination-btn">
          {i18n.resources.next}
        </a>
      ) : (
        <button disabled class="pagination-btn">
          {i18n.resources.next}
        </button>
      )}
    </div>
  )
}

<style>
  .resources-grid-wrapper {
    min-height: 400px;
    position: relative;
    transition: opacity 0.2s ease;
  }

  .resources-grid-wrapper.loading {
    opacity: 0.5;
    pointer-events: none;
  }

  .resources-grid-wrapper.loading::after {
    content: "";
    position: absolute;
    top: 50px;
    left: calc(50% - 20px);
    width: 40px;
    height: 40px;
    border: 4px solid rgba(0, 0, 0, 0.1);
    border-left-color: var(--primary-500);
    border-radius: 50%;
    animation: spin-loading 1s linear infinite;
    z-index: 10;
  }

  @keyframes spin-loading {
    to {
      transform: rotate(360deg);
    }
  }

  .resources-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(18rem, 1fr));
    gap: 2rem;
    justify-content: center;
  }

  .resources-empty {
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    height: 300px;
    font-size: 1.125rem;
    color: var(--black);
    opacity: 0.7;
  }

  .resources-pagination {
    display: flex;
    justify-content: center;
    align-items: center;
    gap: 1.5rem;
    margin-top: 2rem;
  }

  .pagination-btn {
    padding: 0.5rem 1.25rem;
    background-color: var(--primary-500);
    color: white;
    border: none;
    border-radius: var(--border-radius);
    font-size: 1rem;
    font-weight: 500;
    cursor: pointer;
    text-decoration: none;
    transition:
      background-color 0.2s ease,
      transform 0.2s ease;
  }

  .pagination-btn:hover:not(:disabled) {
    background-color: var(--primary-600);
    transform: translateY(-2px);
  }

  .pagination-btn:disabled {
    background-color: var(--gray-300);
    cursor: not-allowed;
    opacity: 0.7;
  }

  .pagination-info {
    font-weight: 500;
    color: var(--black);
  }
</style>

<script>
  // Show loading indicator during Astro ViewTransitions (only for resources pages)
  document.addEventListener("astro:before-preparation", (e) => {
    const destination = e.to?.pathname || "";
    if (!destination.startsWith("/resources")) return;

    const gridWrapper = document.querySelector(".resources-grid-wrapper");
    if (gridWrapper) {
      gridWrapper.classList.add("loading");
    }
  });

  document.addEventListener("astro:page-load", () => {
    const gridWrapper = document.querySelector(".resources-grid-wrapper");
    if (gridWrapper) {
      gridWrapper.classList.remove("loading");
    }
  });
</script>
